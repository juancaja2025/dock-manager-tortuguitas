# Copiá este archivo a .env y completá los valores. NUNCA subas el .env real al repo.

# ID del Google Spreadsheet que oficia de base de datos.
# Es la parte de la URL: https://docs.google.com/spreadsheets/d/<ESTO>/edit
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# JSON COMPLETO de la cuenta de servicio de Google (en una sola línea).
# Lo obtenés al crear la key de la service account en Google Cloud.
# Compartí el Spreadsheet con el client_email de esta cuenta (rol Editor).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"dock-tortuguitas@tu-proyecto.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Contraseña del panel /admin (opcional; default 'Tortuguitas2026')
ADMIN_PASS=Tortuguitas2026
